var protected HxPlayerReplicationInfo HxPRI;

replication
{
    reliable if (Role == ROLE_Authority)
        ClientSetFireRate;
}

function SetFireRate(float Value)
{
    UpdateFireRate(Value);
    ClientSetFireRate(Value);
}

simulated function UpdateFireRate(float Value)
{
    local int i;

    for (i = 0; i < ArrayCount(FireMode); ++i)
    {
        if (ShockBeamFire(FireMode[i]) != None)
        {
            if (Value > 0)
            {
                FireMode[i].FireRate = Value;
            }
            else
            {
                FireMode[i].FireRate = FireMode[i].default.FireRate;
            }
        }
    }
}

simulated function ClientSetFireRate(float Value)
{
    UpdateFireRate(Value);
}

simulated function bool ConsumeAmmo(int Mode, float Load, optional bool bAmountNeededIsMax)
{
    if (Role == ROLE_Authority)
    {
        if (HxPRI == None)
        {
            HxPRI = class'HxPlayerReplicationInfo'.static.Get(Instigator.PlayerReplicationInfo);
        }
        if (HxPRI != None)
        {
            HxPRI.IncrementWeaponShots(Class, 1);
        }
    }
    return Super.ConsumeAmmo(Mode, Load, bAmountNeededIsMax);
}
